# Ensure deterministic LF line endings across Windows, Linux and macOS
* text=auto eol=lf
*.json text eol=lf
*.mjs text eol=lf
*.js text eol=lf
*.cjs text eol=lf
*.kt text eol=lf
*.java text eol=lf
*.gradle.kts text eol=lf
*.md text eol=lf
*.csv text eol=lf
*.txt text eol=lf
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.keystore binary
*.b64 text eol=lf
