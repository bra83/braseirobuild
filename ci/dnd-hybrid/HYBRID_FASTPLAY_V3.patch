+package com.braseiro.dnd5e;
+
+import org.json.JSONArray;
+import org.json.JSONObject;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.robolectric.RobolectricTestRunner;
+import org.robolectric.RuntimeEnvironment;
+import org.robolectric.annotation.Config;
+import static org.junit.Assert.*;
+
+@RunWith(RobolectricTestRunner.class)
+@Config(sdk=35, manifest=Config.NONE)
+public class HybridFastplayUniversalEncounterRobolectricTest {
+    private JSONObject make(String mode) throws Exception {
+        return new JSONObject().put("title","Encontro livre").put("scene","O grupo vê uma ponte coberta de névoa.")
+            .put("edition","5e 2014").put("source_ref","Fonte revisada p.42")
+            .put("source_kind","official").put("action_kind",mode)
+            .put("choices",new JSONArray().put("Investigar").put("Negociar"))
+            .put("dc",12).put("gm_secret","Segredo que não pode sair na visão do jogador");
+    }
+    @Test public void sourceReviewCannotBeSelfCertifiedByData() throws Exception {
+        JSONObject candidate=make("CHOICE").put("source_status","reviewed");boolean failed=false;
+        try{HybridFastplayUniversalEncounter.create(candidate,false);}catch(Exception expected){failed=true;}
+        assertTrue(failed);
+    }
+    @Test public void improvisedEncounterCannotInventDC() throws Exception {
+        JSONObject candidate=make("CHECK_D20").put("source_kind","master_ruling");boolean failed=false;
+        try{HybridFastplayUniversalEncounter.create(candidate,true);}catch(Exception expected){failed=true;}
+        assertTrue(failed);
+    }
+    @Test public void anyReviewedSceneInstallsAndContinuesAcrossReopen() throws Exception {
+        String file="hybrid_universal_"+System.nanoTime()+".db";
+        AppDb db=new AppDb(RuntimeEnvironment.getApplication(),file);
+        JSONObject definition=HybridFastplayUniversalEncounter.create(make("MANUAL_ASSISTED"),true);
+        try{
+            HybridFastplayEngine engine=new HybridFastplayEngine(db);engine.install(definition);
+            JSONObject view=engine.start(definition.getString("id"),1);
+            assertEquals("active",view.getString("status"));assertEquals(2,view.getJSONArray("actions").length());
+            assertFalse(view.toString().contains("Segredo que não pode sair"));
+            JSONObject result=engine.commit(definition.getString("id"),1,"human-decision-1","act1",
+              new JSONObject().put("human_approved",true).put("ruling_source","Fonte revisada p.42")
+                .put("human_ruling","Sem efeitos mecânicos; escolha apenas narrativa"),null);
+            assertEquals("committed",result.getString("status"));
+            assertFalse(result.optJSONObject("mechanics").has("mechanical_receipt"));
+            assertTrue(engine.commit(definition.getString("id"),1,"human-decision-1","act1",
+                new JSONObject().put("human_approved",true),null).optBoolean("replayed"));
+            db.close();db=new AppDb(RuntimeEnvironment.getApplication(),file);
+            engine=new HybridFastplayEngine(db);
+            assertEquals("resolution",engine.view(definition.getString("id"),1,false).optString("step_id"));
+            result=engine.commit(definition.getString("id"),1,"human-finish","finish",
+                new JSONObject().put("human_approved",true),null);
+            assertTrue(result.optBoolean("completed"));
+        }finally{db.close();}
+    }
+    @Test public void reviewedD20HasTwoExplicitBranchesAndNoAutomaticStateEffect() throws Exception {
+        JSONObject result=HybridFastplayUniversalEncounter.create(make("CHECK_D20"),true);
+        HybridFastplayEngine.validateDefinition(result);
+        JSONObject a=result.getJSONArray("steps").getJSONObject(0).getJSONArray("actions").getJSONObject(0);
+        assertEquals(12,a.getInt("dc"));assertEquals("success",a.getString("success_step"));assertEquals("failure",a.getString("failure_step"));
+        assertFalse(a.has("mechanical_effects"));
+    }
+}
