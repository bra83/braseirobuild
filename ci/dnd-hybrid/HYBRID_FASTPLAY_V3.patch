+package com.braseiro.dnd5e;
+
+import org.json.JSONArray;
+import org.json.JSONObject;
+import java.util.UUID;
+
+/**
+ * Creates encounter DATA, not individual hard-coded adventures. A human reviewer
+ * must identify the official edition/source OR explicitly mark an improvised scene.
+ * This factory has no access to SQLite, a dice roller, AI, RAG or mutable game state.
+ * Mechanics are only committed by HybridFastplayEngine's native executor.
+ */
+public final class HybridFastplayUniversalEncounter {
+    private HybridFastplayUniversalEncounter(){}
+    private static String field(JSONObject in,String name,int max)throws Exception{
+        String value=in==null?"":in.optString(name,"").trim();
+        if(value.isEmpty()||value.length()>max)throw new IllegalArgumentException("Campo vazio ou muito longo: "+name);
+        return value;
+    }
+    /** actionKind: CHOICE, CHECK_D20 or MANUAL_ASSISTED. */
+    public static JSONObject create(JSONObject input,boolean explicitHumanReview)throws Exception{
+        if(!explicitHumanReview)throw new IllegalArgumentException("A Mestra precisa revisar fonte e texto antes de instalar o encontro");
+        String title=field(input,"title",180),scene=field(input,"scene",6000);
+        String source=field(input,"source_ref",256),edition=field(input,"edition",128);
+        String kind=field(input,"action_kind",32);
+        if(!"CHOICE".equals(kind)&&!"CHECK_D20".equals(kind)&&!"MANUAL_ASSISTED".equals(kind))
+            throw new IllegalArgumentException("Resolução não autorizada: "+kind);
+        String sourceKind=input.optString("source_kind","official");
+        if(!"official".equals(sourceKind)&&!"master_ruling".equals(sourceKind))
+            throw new IllegalArgumentException("Tipo de fonte não identificado");
+        if("master_ruling".equals(sourceKind)&&"CHECK_D20".equals(kind))
+            throw new IllegalArgumentException("CD de teste exige fonte oficial verificada; use resolução assistida");
+        int dc=input.optInt("dc",-1);
+        if("CHECK_D20".equals(kind)&&(dc<0||dc>40||!input.has("dc")))
+            throw new IllegalArgumentException("Informe a CD da regra oficial; jamais a deduza pelo texto");
+        JSONArray choices=input.optJSONArray("choices");
+        if(choices==null||choices.length()<1||choices.length()>8)throw new IllegalArgumentException("Informe de 1 a 8 ações");
+        String id="hybrid-free-"+UUID.randomUUID();
+        JSONObject root=new JSONObject().put("id","scene").put("public_text",scene)
+            .put("gm_secret",input.optString("gm_secret","")).put("actions",new JSONArray());
+        JSONArray actions=root.getJSONArray("actions");
+        for(int i=0;i<choices.length();i++){
+            String label=choices.optString(i,"").trim();
+            if(label.isEmpty()||label.length()>180)throw new IllegalArgumentException("Escolha vazia ou muito longa");
+            JSONObject a=new JSONObject().put("id","act"+(i+1)).put("label",label)
+                .put("source_ref",source).put("executor",kind);
+            if("CHECK_D20".equals(kind))a.put("dc",dc).put("success_step","success").put("failure_step","failure");
+            else a.put("next_step","resolution");
+            actions.put(a);
+        }
+        JSONArray steps=new JSONArray().put(root);
+        if("CHECK_D20".equals(kind)){
+            steps.put(conclusionStep("success",input.optString("success_text","Sucesso registrado; a Mestra descreve a consequência segundo a fonte, sem efeito automático."),source));
+            steps.put(conclusionStep("failure",input.optString("failure_text","Falha registrada; a Mestra descreve a consequência segundo a fonte, sem efeito automático."),source));
+        }else steps.put(conclusionStep("resolution",input.optString("resolution_text","Decisão registrada. Efeitos mecânicos devem ser resolvidos nos motores do jogo antes da conclusão."),source));
+        JSONObject d=new JSONObject().put("id",id).put("title",title)
+            .put("source_ref",source).put("source_kind",sourceKind).put("edition",edition)
+            .put("source_status","reviewed").put("root_step","scene").put("steps",steps)
+            .put("created_by","human_reviewed_fastplay_v3");
+        HybridFastplayEngine.validateDefinition(d);
+        return d;
+    }
+    private static JSONObject conclusionStep(String id,String text,String source)throws Exception{
+        if(text==null||text.trim().isEmpty()||text.length()>6000)throw new IllegalArgumentException("Desfecho narrativo inválido");
+        JSONObject finalChoice=new JSONObject().put("id","finish")
+            .put("label","Encerrar encontro (não aplica efeitos mecânicos)")
+            .put("source_ref",source).put("executor","CHOICE")
+            .put("next_step",id).put("ends_encounter",true);
+        return new JSONObject().put("id",id).put("public_text",text.trim())
+            .put("actions",new JSONArray().put(finalChoice));
+    }
+}
