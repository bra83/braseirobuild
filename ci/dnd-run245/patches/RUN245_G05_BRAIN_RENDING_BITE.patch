+        JSONObject scene=new ProceduralTacticalSceneGenerator(db).ensureForCurrentScene();
+        assertEquals(12,scene.optInt("width_cells"));
+        db.ensureTacticalTokensForCombat();position(db,actor,2,2);position(db,target,3,2);
+    }
