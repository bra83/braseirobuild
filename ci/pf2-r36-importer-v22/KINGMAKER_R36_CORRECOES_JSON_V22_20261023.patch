+package com.braseiro.pathfinder2e;
+
+import java.util.regex.Pattern;
+/** Apenas a entrada TTS é limpa; a cena canônica nunca é modificada. */
+public final class BraseiroSpokenTextSanitizer {
+    private static final Pattern VOCAL = Pattern.compile("(?i)\\[\\s*(?:voz|voice|speaker|perfil\\s+vocal|estilo\\s+vocal|voice\\s+profile|voice\\s+style|emotion|emoção|tom|tone|sfx|pause|pausa|style|profile)\\s*[:=][^\\]\\r\\n]{0,200}\\]");
+    private static final Pattern META = Pattern.compile("(?i)<\\s*/?\\s*(?:sigh|breath|short[ -]pause|laugh|cough|speaker|voice)(?:\\s+[^>]*)?\\s*/?\\s*>");
+    private static final Pattern LABEL = Pattern.compile("(?im)^(?:Speaker\\s*\\d+|Locutor\\s*\\d+|NARRADOR|VOICE|PERFIL\\s+VOCAL|ESTILO\\s+VOCAL)\\s*:\\s*");
+    private static final Pattern SPACES = Pattern.compile("\\s+");
+    private BraseiroSpokenTextSanitizer() {}
+    public static String sanitize(String raw){
+        if(raw==null)return "";
+        String spoken=META.matcher(raw).replaceAll(" ");
+        spoken=VOCAL.matcher(spoken).replaceAll(" ");
+        spoken=LABEL.matcher(spoken).replaceAll("");
+        return SPACES.matcher(spoken).replaceAll(" ").trim();
+    }
+}
