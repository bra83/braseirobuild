<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Campanha, banco, preferências funcionais, snapshots e avatares permanecem no backup. -->
    <exclude domain="cache" path="." />
    <exclude domain="file" path="tts_cache_v6" />
    <exclude domain="file" path="tts_cache_v7" />
    <exclude domain="file" path="maps" />
    <exclude domain="file" path="map_packages" />
    <exclude domain="file" path="bundled_manuals" />
    <exclude domain="file" path="token_cache" />
    <exclude domain="file" path="diagnostics" />
    <exclude domain="file" path="startup_crash.txt" />
    <!-- Segredos são vinculados ao Android Keystore e nunca devem sair do aparelho. -->
    <exclude domain="sharedpref" path="secure_secrets.xml" />
</full-backup-content>
